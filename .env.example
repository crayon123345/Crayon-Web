# Server-side only. Never commit a real .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional: switch provider
LLM_PROVIDER=gemini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional: Groq free tier as extra fallback (no card needed; console.groq.com -> API Keys)
GROQ_API_KEY=
CRAYON_GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
# DeepSeek R1 Distill (reasoning) joins the default Groq chain; set empty to disable
CRAYON_GROQ_DEEPSEEK=deepseek-r1-distill-llama-70b
RATE_PER_MIN=12
RATE_GLOBAL_DAY=1500
